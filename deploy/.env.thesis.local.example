# Copy to the environment root .env and fill existing credentials. Nothing is generated or reset automatically.
# Keep database name/user/password unchanged after the first initialization.
MYSQL_DATABASE=firstsun_thesis_local
MYSQL_USER=thesis
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
MYSQL_PORT=23327
REDIS_PORT=26397
BACKEND_PORT=28080
ADMIN_PORT=28081
PHARMACY_DEV_SMS_CODE=
PHARMACY_AI_API_KEY=
PHARMACY_AI_BASE_URL=
PHARMACY_AI_MODEL=
PHARMACY_WECHAT_TENANT_ID=
PHARMACY_WECHAT_APP_ID=
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
CUSTOMER_PORT=4193
FIRSTSUN_MYSQL_VOLUME=firstsun-thesis-local_mysql-data
FIRSTSUN_REDIS_VOLUME=firstsun-thesis-local_redis-data
FIRSTSUN_LOGS_VOLUME=firstsun-thesis-local_backend-logs
# Existing mail account configuration; leave disabled until private credentials are set.
PHARMACY_MEMBER_EMAIL_ENABLED=false
PHARMACY_MEMBER_EMAIL_FROM=
PHARMACY_MEMBER_EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=
# Optional application connection override; initialization database remains unchanged.
FIRSTSUN_APP_DATABASE=
FIRSTSUN_REDIS_DATABASE=0
FIRSTSUN_ORDER_EXPIRY_ENABLED=true
FIRSTSUN_TENANT_ID=163

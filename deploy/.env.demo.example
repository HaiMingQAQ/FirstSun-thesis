# 同机演示专用配置，复制到 .local/demo/.env 后填入本机数据库和 Redis 密码。
FIRSTSUN_PROJECT_NAME=firstsun-demo
# 三个外部卷默认随项目名；创建 <项目名>_mysql-data、<项目名>_redis-data、<项目名>_backend-logs。

MYSQL_DATABASE=firstsun_demo_local
MYSQL_USER=thesis
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
FIRSTSUN_APP_DATABASE=firstsun_demo_local
FIRSTSUN_TENANT_ID=901
FIRSTSUN_PAY_APP_KEY=firstsun-demo
FIRSTSUN_MOCK_PAYMENT_ENABLED=true
FIRSTSUN_LOCAL_TEST_LOGIN=true
FIRSTSUN_BACKEND_URL=http://127.0.0.1:38080
PHARMACY_DEV_SMS_CODE=609012

MYSQL_PORT=33327
REDIS_PORT=36397
BACKEND_PORT=38080
ADMIN_PORT=38081
CUSTOMER_PORT=5193
QDRANT_HTTP_PORT=36333
QDRANT_GRPC_PORT=36334

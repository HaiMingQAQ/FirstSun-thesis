# ==================================================
# 生产环境环境变量
# 由 vite 通过 envPrefix "SHOPRO_" 注入 import.meta.env
# ==================================================

# 后端接口基础地址（正式环境；微信发布构建前必须配置 HTTPS 可达地址）
SHOPRO_BASE_URL=

# 后端接口基础地址（体验版）
SHOPRO_TRIAL_BASE_URL=

# 接口前缀
SHOPRO_API_PATH=/app-api

# 多租户编号（药店演示数据在租户 163）
SHOPRO_TENANT_ID=163

# 静态资源地址
SHOPRO_STATIC_URL=

# WebSocket 路径
SHOPRO_WEBSOCKET_PATH=/infra/ws

# H5 站点访问地址
SHOPRO_H5_URL=

# 上传方式：server = 后端中转上传，client = 前端直连上传
SHOPRO_UPLOAD_TYPE=server

# 微信小程序直播插件开关（仅 mp-weixin 平台生效）
SHOPRO_MPLIVE_ON=0

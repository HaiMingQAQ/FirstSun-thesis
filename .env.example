# 复制本文件为 .env 并填写（.env 已被 .gitignore 忽略，不会提交到 GitHub）
# 建议团队统一一套值，保证所有人连的库名/账号一致。
# 下面这套是「本机演示环境」的默认组合，直接照抄即可起服务；标注「按需」的可以留空。

# ---------- 端口（刻意避开 3306/6379/8080 这类常见占用） ----------
MYSQL_PORT=23327
REDIS_PORT=26397
BACKEND_PORT=28080
ADMIN_PORT=28081
CUSTOMER_PORT=4193
# 手机端 H5 习惯用 5173，由任意静态服务器托管，不在 compose 里

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=firstsun_thesis_local
MYSQL_USER=thesis
MYSQL_PASSWORD=thesis123456
# 业务库名（与 MYSQL_DATABASE 可以不同：这里是 901 租户的随访库）
FIRSTSUN_APP_DATABASE=firstsun_followup_20261012

# ---------- Redis ----------
REDIS_PASSWORD=redis123456
FIRSTSUN_REDIS_DATABASE=1

# ---------- 后端 ----------
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
VITE_BASE_URL=http://localhost:28080
# 启动器选哪个工作树作为镜像构建源（FirstSun-thesis 即 main）
FIRSTSUN_SOURCE_DIR=FirstSun-thesis
# 901 租户
FIRSTSUN_TENANT_ID=901

# ---------- 药店模块 ----------
# 模拟支付：本地演示必须为 true，否则下单后无法付款
FIRSTSUN_MOCK_PAYMENT_ENABLED=true
# 微信支付 appKey，需与 ph_app 里登记的 appKey 一致
FIRSTSUN_PAY_APP_KEY=firstsun
# 超时未支付自动关单（演示时建议 false，免得下单后聊两句话订单就被关掉）
FIRSTSUN_ORDER_EXPIRY_ENABLED=false

# ---------- AI 大模型 ----------
# 只填到本地 .env，禁止提交真实值
PHARMACY_AI_API_KEY=
PHARMACY_AI_BASE_URL=https://api.deepseek.com
PHARMACY_AI_MODEL=deepseek-flash

# ---------- 会员手机号快捷登录的「开发测试验证码」 ----------
# - 只在本机 .env 里填写，禁止把真实值写进代码、前端、SQL 或 Dockerfile
# - 仅 local/dev profile 生效；prod 会整体禁用手机号快捷登录
# - 前端输入框限 6 位，这里也填 6 位数字
PHARMACY_DEV_SMS_CODE=123456

# ---------- 会员邮件（按需） ----------
PHARMACY_MEMBER_EMAIL_ENABLED=false
PHARMACY_MEMBER_EMAIL_FROM=onboarding@resend.dev
PHARMACY_MEMBER_EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=

# ---------- 微信（按需；不做真机时全部留空） ----------
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=
PHARMACY_WECHAT_TENANT_ID=163
PHARMACY_WECHAT_APP_ID=

# ---------- RAG（一般不用改） ----------
# backend 容器访问向量化服务的地址，compose 默认 http://embedding:8000
FIRSTSUN_EMBEDDING_URL=http://embedding:8000

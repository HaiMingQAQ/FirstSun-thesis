# Template only. Copy outside the repository, fill every required value, then chmod 600.
# This example does not identify or approve an isolated stack and is not green by default.
E2E_ENVIRONMENT_ID=replace-with-reviewed-isolated-environment-id
E2E_ISOLATED_CONFIRM=I_CONFIRM_ISOLATED_OTC_WRITES

# Illustrative loopback ports only; confirm these are free and isolated for your machine.
# They are not shared ports, but still require independent stack manifest review.
E2E_CUSTOMER_BASE_URL=http://127.0.0.1:18081
E2E_ADMIN_BASE_URL=http://127.0.0.1:18082
E2E_API_BASE_URL=http://127.0.0.1:18083
# Tenant/store are fixed by this harness; they are not network ports.
E2E_TENANT_ID=901
E2E_STORE_ID=9101
E2E_RUN_ID=otc-replace-with-unique-run-id
E2E_ARTIFACT_ROOT=/absolute/path/outside/repository/otc-evidence

E2E_FIXTURE_DRUG_ID=replace-with-approved-ordinary-otc-id
E2E_FIXTURE_DRUG_NAME=replace-with-exact-fixture-name
E2E_FIXTURE_QUANTITY=1
E2E_MEMBER_ID=replace-with-dedicated-member-id
E2E_ADMIN_USER_ID=replace-with-dedicated-admin-user-id

# Default login mode is email-password. Only use local credentials if explicitly provisioned.
E2E_CUSTOMER_LOGIN_MODE=email-password
E2E_CUSTOMER_EMAIL=replace-with-dedicated-customer-email
E2E_CUSTOMER_PASSWORD=replace-with-secret
# Optional local login placeholders; choose local-password or local-code mode to use them.
E2E_CUSTOMER_LOCAL_MOBILE=
E2E_CUSTOMER_LOCAL_PASSWORD=
E2E_CUSTOMER_LOCAL_CODE=
E2E_ADMIN_USERNAME=replace-with-dedicated-admin-username
E2E_ADMIN_PASSWORD=replace-with-secret
E2E_ADMIN_TENANT_NAME=replace-with-reviewed-tenant-name

# Read-only loopback MySQL connection. Port is illustrative, not a selection or approval.
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=13307
E2E_DB_NAME=replace-with-isolated-schema
E2E_DB_USER=replace-with-readonly-account
E2E_DB_PASSWORD=replace-with-secret

# Both files must be absolute and outside the repository. Review and pin the module independently.
E2E_RECONCILER_MODULE=/absolute/path/outside/repository/otc-sql-adapter.mjs
E2E_RECONCILER_SHA256=replace-with-reviewed-lowercase-sha256
E2E_STACK_REVIEW_FILE=/absolute/path/outside/repository/otc-stack-review.json

# Required before readiness/oneclick; approves replaying mock payment and verification on this run's same order.
E2E_REPLAY_CONFIRM=I_APPROVE_SAME_ORDER_MOCK_PAY_AND_VERIFY_REPLAY

# Optional settings (defaults shown).
E2E_API_HEALTH_PATH=/actuator/health
E2E_TIMEOUT_MS=15000
E2E_POLL_INTERVAL_MS=1000
# Set YES only after independent manual review when using a recorded isolated port.
# E2E_ALLOW_ISOLATED_RECORDED_PORTS=YES
